# Server
PORT=9200
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/dbname
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASSWORD=your_password_here
DB_NAME=your_db_name

# JWT
JWT_SECRET=your_jwt_secret_here_make_it_long_and_random

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Brevo / SMTP)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password_here
BREVO_API_KEY=your_brevo_api_key_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id

# Flutterwave (payments — MUST match the environment the app is deployed in)
# FLWSECK_TEST- / FLWPUBK_TEST- for test, FLWSECK_LIVE- / FLWPUBK_LIVE- for live.
# FLW_SECRET_HASH is the webhook secret-hash set on the Flutterwave dashboard;
# if it is missing/empty every webhook is rejected with 401 and top-ups never credit.
FLW_PUBLIC_KEY=FLWPUBK_TEST_your_public_key
FLW_SECRET_KEY=FLWSECK_TEST_your_secret_key
FLW_SECRET_HASH=your_webhook_secret_hash
FLW_CALLBACK_URL=https://rentulo.ng/wallet/topup/verify-callback
FLW_REDIRECT_URL=https://rentulo.ng/tenant/wallet
FLW_FAILURE_URL=https://rentulo.ng/tenant/wallet

# Pending-transaction reconciliation (credits top-ups whose webhook was missed)
RECONCILE_CRON_ENABLED=true
RECONCILE_CRON_SCHEDULE=*/3 * * * *

# CORS (comma-separated origins)
ALLOWED_ORIGINS=https://rentulo.ng,https://www.rentulo.ng,http://localhost:3000

# OpenAI (AI Support Chat)
OPENAI_API_KEY=sk-your_openai_api_key_here
